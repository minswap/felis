{
  "name": "minswap-felis",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/minswap/felis"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "check-types": "turbo run check-types",
    "format-and-lint": "biome check .",
    "format-and-lint:fix": "biome check . --write --unsafe",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "publish:dry": "pnpm -r publish --dry-run --no-git-checks",
    "publish:release": "pnpm -r publish --no-git-checks"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.4",
    "turbo": "^2.5.5",
    "typescript": "5.8.3"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "flatted@<=3.4.1": "3.4.2",
      "glob@>=10.2.0 <10.5.0": "10.5.0",
      "minimatch@<3.1.4": "3.1.5",
      "minimatch@>=9.0.0 <9.0.7": "9.0.9",
      "rollup@>=4.0.0 <4.59.0": "4.60.0",
      "socket.io-parser@>=4.0.0 <4.2.6": "4.2.6",
      "lodash@<4.17.23": "4.17.23"
    }
  }
}
